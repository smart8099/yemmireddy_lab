---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { getSettings, mailto } from '../lib/site';

const settings = await getSettings();
const mapQuery = encodeURIComponent(settings.map_query ?? settings.address);
const mapsLink = `https://www.google.com/maps/search/?api=1&query=${mapQuery}`;
---

<BaseLayout title="Contact" description={`Contact ${settings.pi_name} and the ${settings.name} at ${settings.university_name}.`}>
  <PageHero eyebrow="Get in touch" title="Contact Us" subtitle="Interested in our research, joining the lab, or collaborating? We'd love to hear from you." />

  <section class="section">
    <div class="container contact-grid">
      <div class="card contact-card">
        <h2>{settings.pi_name}</h2>
        {settings.pi_title && <p class="contact-title">{settings.pi_title}</p>}
        <p class="contact-depts">
          {settings.departments.map((d) => <span>{d}</span>)}
          <span>{settings.university_name}</span>
        </p>

        <dl class="contact-list">
          <div>
            <dt>Email</dt>
            <dd><a href={mailto(settings.email)}>{settings.email}</a></dd>
          </div>
          {
            settings.phone && (
              <div>
                <dt>Phone</dt>
                <dd><a href={`tel:${settings.phone.replace(/[^\d+]/g, '')}`}>{settings.phone}</a></dd>
              </div>
            )
          }
          {
            settings.office && (
              <div>
                <dt>Office</dt>
                <dd>{settings.office}</dd>
              </div>
            )
          }
          <div>
            <dt>Address</dt>
            <dd>
              <address>{settings.address}</address>
              <a href={mapsLink}>Get directions</a>
            </dd>
          </div>
        </dl>
      </div>

      <div class="map">
        <iframe
          title={`Map showing ${settings.address}`}
          src={`https://www.google.com/maps?q=${mapQuery}&output=embed`}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"></iframe>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-grid {
    display: grid;
    gap: var(--space-xl);
  }

  @media (min-width: 900px) {
    .contact-grid {
      grid-template-columns: 1fr 1.2fr;
      align-items: stretch;
    }
  }

  .contact-card {
    padding: var(--space-xl);
  }

  .contact-card h2 {
    font-size: var(--step-2);
    margin-bottom: 0.2rem;
  }

  .contact-title {
    font-weight: 600;
    color: var(--color-accent);
  }

  .contact-depts {
    display: flex;
    flex-direction: column;
    color: var(--color-muted);
    font-size: var(--step--1);
  }

  .contact-list {
    margin: var(--space-l) 0 0;
    display: grid;
    gap: var(--space-m);
  }

  .contact-list div {
    padding-top: var(--space-m);
    border-top: 1px solid var(--color-line);
  }

  .contact-list dt {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .contact-list dd {
    margin: 0;
    overflow-wrap: anywhere;
  }

  address {
    font-style: normal;
  }

  .map {
    min-height: 360px;
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow);
    background: var(--color-line);
  }

  .map iframe {
    width: 100%;
    height: 100%;
    min-height: 360px;
    border: 0;
    display: block;
  }
</style>
