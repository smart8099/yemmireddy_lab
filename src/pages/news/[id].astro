---
import { render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate, getPublishedNews, getSettings, url } from '../../lib/site';

export async function getStaticPaths() {
  const posts = await getPublishedNews();
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props as { post: CollectionEntry<'news'> };
const { Content } = await render(post);
const settings = await getSettings();
const d = post.data;

const jsonLd = {
  '@type': 'NewsArticle',
  headline: d.title,
  description: d.summary,
  datePublished: d.date.toISOString(),
  author: { '@type': 'Organization', name: settings.name },
  publisher: { '@type': 'Organization', name: settings.name },
  mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).href,
};
---

<BaseLayout title={d.title} description={d.summary} image={d.cover} imageAlt={d.cover_alt} type="article" jsonLd={jsonLd}>
  <article class="post">
    <header class="container--narrow post-head">
      <nav aria-label="Breadcrumb" class="crumbs"><a href={url('news/')}>News</a></nav>
      <h1>{d.title}</h1>
      <p class="post-meta">
        <time datetime={d.date.toISOString()}>{formatDate(d.date)}</time>
        {d.tags.map((t) => <span class="tag">{t}</span>)}
      </p>
    </header>
    {
      d.cover && (
        <figure class="container post-cover">
          <Image src={d.cover} alt={d.cover_alt ?? ''} widths={[640, 1000, 1400]} sizes="(min-width: 1150px) 1100px, 96vw" loading="eager" />
        </figure>
      )
    }
    <div class="container--narrow prose">
      <Content />
      <p class="back"><a href={url('news/')}>← All news</a></p>
    </div>
  </article>
</BaseLayout>

<style>
  .post {
    padding-block: var(--space-2xl);
  }

  .post-head h1 {
    font-size: var(--step-3);
  }

  .crumbs {
    font-size: var(--step--1);
    margin-bottom: var(--space-s);
  }

  .post-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
    color: var(--color-muted);
    font-size: var(--step--1);
  }

  .post-cover {
    margin-block: var(--space-l) var(--space-xl);
  }

  .post-cover img {
    width: 100%;
    max-height: 560px;
    object-fit: cover;
    border-radius: var(--radius);
  }

  .back {
    margin-top: var(--space-xl);
  }
</style>
