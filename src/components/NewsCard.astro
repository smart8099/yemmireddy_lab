---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { formatDate, url } from '../lib/site';

interface Props {
  post: CollectionEntry<'news'>;
  headingLevel?: 'h2' | 'h3';
}
const { post, headingLevel: H = 'h3' } = Astro.props;
const href = url(`news/${post.id}/`);
---

<article class="news-card">
  {
    post.data.cover && (
      <a href={href} class="news-cover" tabindex="-1" aria-hidden="true">
        <Image src={post.data.cover} alt="" widths={[400, 700]} sizes="(min-width: 900px) 33vw, 92vw" />
      </a>
    )
  }
  <div class="news-body">
    <p class="news-meta">
      <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
      {post.data.tags.map((t) => <span class="tag">{t}</span>)}
    </p>
    <H class="news-title"><a href={href}>{post.data.title}</a></H>
    <p class="news-summary">{post.data.summary}</p>
  </div>
</article>

<style>
  .news-card {
    display: flex;
    flex-direction: column;
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow);
    transition: transform 0.25s, box-shadow 0.25s;
  }

  .news-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-lift);
  }

  .news-cover img {
    aspect-ratio: 16 / 9;
    width: 100%;
    object-fit: cover;
  }

  .news-body {
    padding: var(--space-l);
  }

  .news-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--step--1);
    color: var(--color-muted);
    margin-bottom: var(--space-xs);
  }

  .news-title {
    font-size: var(--step-1);
  }

  .news-title a {
    color: inherit;
    text-decoration: none;
  }

  .news-title a:hover {
    color: var(--color-primary);
  }

  .news-summary {
    color: var(--color-muted);
    font-size: var(--step--1);
    margin: 0;
  }
</style>
