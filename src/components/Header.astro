---
import { getSettings, nav, url } from '../lib/site';

const settings = await getSettings();
const current = Astro.url.pathname.replace(/\/$/, '');
const isActive = (href: string) => {
  const target = url(href).replace(/\/$/, '');
  return href === '' ? current === target : current === target || current.startsWith(`${target}/`);
};
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href={url()} aria-label={`${settings.name} home`}>
      <span class="brand-mark" aria-hidden="true">
        <svg viewBox="0 0 40 40" width="40" height="40">
          <circle cx="20" cy="20" r="19" fill="var(--color-primary)" />
          <path d="M12 27c3-9 9-14 17-15-1 8-6 14-15 16" fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round" />
          <circle cx="15.5" cy="15" r="2.4" fill="var(--color-accent)" />
          <circle cx="25" cy="25.5" r="1.8" fill="#9fd3cb" />
        </svg>
      </span>
      <span class="brand-text">
        <span class="brand-name">{settings.short_name}</span>
        <span class="brand-sub">Food Safety &amp; Food Microbiology</span>
      </span>
    </a>

    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
      <span class="visually-hidden">Menu</span>
      <span class="nav-toggle-bar" aria-hidden="true"></span>
    </button>

    <nav id="site-nav" class="site-nav" aria-label="Main">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={url(item.href)} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
  const header = document.querySelector('.site-header');
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    header?.classList.toggle('is-open', !open);
    document.body.classList.toggle('nav-locked', !open);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && header?.classList.contains('is-open')) toggle?.click();
  });
  const onScroll = () => header?.classList.toggle('is-scrolled', window.scrollY > 8);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s, box-shadow 0.2s;
  }

  /* Blur lives on a pseudo-element so the fixed mobile menu is positioned
     against the viewport, not the header. */
  .site-header::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: rgb(251 250 247 / 0.92);
    backdrop-filter: saturate(1.4) blur(10px);
    -webkit-backdrop-filter: saturate(1.4) blur(10px);
  }

  .site-header.is-open::before {
    background: var(--color-bg);
  }

  .site-header.is-scrolled {
    border-bottom-color: var(--color-line);
    box-shadow: 0 4px 18px rgb(16 40 37 / 0.06);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-m);
    min-height: var(--header-h);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    text-decoration: none;
    color: var(--color-primary-strong);
    flex-shrink: 0;
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
  }

  .brand-name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.25rem;
  }

  .brand-sub {
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .site-nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 0.15rem;
  }

  .site-nav a {
    display: block;
    padding: 0.5rem 0.7rem;
    border-radius: 999px;
    font-size: 0.92rem;
    font-weight: 550;
    color: var(--color-text);
    text-decoration: none;
    white-space: nowrap;
  }

  .site-nav a:hover {
    color: var(--color-primary);
    background: var(--color-primary-soft);
  }

  .site-nav a[aria-current='page'] {
    color: var(--color-primary);
    background: var(--color-primary-soft);
  }

  .nav-toggle {
    display: none;
  }

  @media (max-width: 1100px) {
    .nav-toggle {
      display: grid;
      place-items: center;
      width: 2.75rem;
      height: 2.75rem;
      border: 1px solid var(--color-line);
      border-radius: 999px;
      background: var(--color-surface);
      cursor: pointer;
      z-index: 2;
    }

    .nav-toggle-bar,
    .nav-toggle-bar::before,
    .nav-toggle-bar::after {
      display: block;
      width: 1.15rem;
      height: 2px;
      background: var(--color-primary-strong);
      border-radius: 2px;
      transition: transform 0.25s, opacity 0.2s;
      position: relative;
    }

    .nav-toggle-bar::before,
    .nav-toggle-bar::after {
      content: '';
      position: absolute;
      left: 0;
    }

    .nav-toggle-bar::before { top: -6px; }
    .nav-toggle-bar::after { top: 6px; }

    .is-open .nav-toggle-bar { background: transparent; }
    .is-open .nav-toggle-bar::before { transform: translateY(6px) rotate(45deg); }
    .is-open .nav-toggle-bar::after { transform: translateY(-6px) rotate(-45deg); }

    .site-nav {
      position: fixed;
      inset: var(--header-h) 0 0 0;
      background: var(--color-bg);
      padding: var(--space-l) var(--gutter);
      overflow-y: auto;
      visibility: hidden;
      opacity: 0;
      transform: translateY(-8px);
      transition: opacity 0.2s, transform 0.2s, visibility 0.2s;
    }

    .is-open .site-nav {
      visibility: visible;
      opacity: 1;
      transform: none;
    }

    .site-nav ul {
      flex-direction: column;
      gap: 0.25rem;
      max-width: 32rem;
      margin-inline: auto;
    }

    .site-nav a {
      font-size: 1.15rem;
      padding: 0.85rem 1rem;
      border-radius: var(--radius-s);
    }
  }

  @media (max-width: 380px) {
    .brand-sub { display: none; }
  }

  :global(body.nav-locked) {
    overflow: hidden;
  }
</style>
