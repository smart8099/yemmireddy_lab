---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { getSettings } from '../lib/site';

export interface SEOProps {
  title?: string;
  description?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  type?: 'website' | 'article' | 'profile';
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
}

const { title, description, image, imageAlt, type = 'website', jsonLd, noindex = false } = Astro.props as SEOProps;
const settings = await getSettings();

const fullTitle = title ? `${title} | ${settings.name}` : `${settings.name} | ${settings.tagline}`;
const desc = description ?? settings.description;
const canonical = new URL(Astro.url.pathname, Astro.site);

const shareSource = image ?? settings.social_image;
const share = shareSource ? await getImage({ src: shareSource, width: 1200, height: 630, fit: 'cover', format: 'jpg' }) : undefined;
const shareUrl = share ? new URL(share.src, Astro.site).href : undefined;

const schemas = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<title>{fullTitle}</title>
<meta name="description" content={desc} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex" />}

<meta property="og:type" content={type} />
<meta property="og:site_name" content={settings.name} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={desc} />
<meta property="og:url" content={canonical} />
<meta property="og:locale" content="en_US" />
{shareUrl && <meta property="og:image" content={shareUrl} />}
{shareUrl && <meta property="og:image:width" content="1200" />}
{shareUrl && <meta property="og:image:height" content="630" />}
{shareUrl && <meta property="og:image:alt" content={imageAlt ?? settings.name} />}
<meta name="twitter:card" content={shareUrl ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={desc} />
{shareUrl && <meta name="twitter:image" content={shareUrl} />}

{schemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', ...s })} />)}
