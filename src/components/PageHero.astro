---
interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
}
const { eyebrow, title, subtitle } = Astro.props;
---

<section class="page-hero">
  <div class="container">
    {eyebrow && <span class="eyebrow">{eyebrow}</span>}
    <h1>{title}</h1>
    {subtitle && <p class="page-hero-sub">{subtitle}</p>}
    <slot />
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(2.5rem, 1.5rem + 5vw, 5rem) clamp(2rem, 1rem + 3vw, 3.5rem);
    background:
      radial-gradient(60rem 22rem at 90% -10%, rgb(200 86 26 / 0.12), transparent 60%),
      radial-gradient(50rem 26rem at -10% 120%, rgb(14 90 84 / 0.14), transparent 60%),
      var(--color-primary-soft);
    border-bottom: 1px solid var(--color-line);
  }

  .page-hero h1 {
    max-width: 22ch;
    margin-bottom: var(--space-s);
  }

  .page-hero-sub {
    font-family: var(--font-display);
    font-size: var(--step-2);
    line-height: 1.3;
    color: var(--color-primary);
    max-width: 36ch;
    margin: 0;
  }
</style>
