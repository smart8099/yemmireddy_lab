---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Lightbox from './Lightbox.astro';

interface Props {
  photos: { image: ImageMetadata; alt: string; caption?: string }[];
  /** "grid" = uniform tiles, "masonry" = keep natural aspect ratios */
  layout?: 'grid' | 'masonry';
}
const { photos, layout = 'grid' } = Astro.props;
---

<div class:list={['gallery', `gallery--${layout}`]}>
  {
    photos.map((p) => (
      <figure>
        <a href={p.image.src} class="gallery-link" data-lightbox data-alt={p.alt} data-caption={p.caption ?? ''}>
          <Image src={p.image} alt={p.alt} widths={[400, 700, 1000]} sizes="(min-width: 1000px) 25vw, 48vw" />
        </a>
        {p.caption && <figcaption>{p.caption}</figcaption>}
      </figure>
    ))
  }
</div>
<Lightbox />

<style>
  .gallery {
    display: grid;
    gap: var(--space-m);
  }

  .gallery figure {
    margin: 0;
  }

  .gallery-link {
    display: block;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--color-line);
    box-shadow: var(--shadow);
  }

  .gallery img {
    width: 100%;
    transition: transform 0.4s ease;
  }

  .gallery-link:hover img {
    transform: scale(1.04);
  }

  .gallery figcaption {
    font-size: var(--step--1);
    color: var(--color-muted);
    margin-top: 0.4rem;
  }

  .gallery--grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-s);
  }

  @media (min-width: 640px) {
    .gallery--grid {
      grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr));
      gap: var(--space-m);
    }
  }

  .gallery--grid img {
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .gallery--masonry {
    display: block;
    columns: 2;
    column-gap: var(--space-m);
  }

  @media (min-width: 900px) {
    .gallery--masonry {
      columns: 3;
    }
  }

  .gallery--masonry figure {
    break-inside: avoid;
    margin-bottom: var(--space-m);
  }

</style>
