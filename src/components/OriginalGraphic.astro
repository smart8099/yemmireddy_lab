---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Lightbox from './Lightbox.astro';

/** An original infographic shown beneath its HTML-rebuilt diagram; opens full size. */
interface Props {
  photo: { image: ImageMetadata; alt: string };
}
const { photo } = Astro.props;
---

<figure class="og">
  <a href={photo.image.src} data-lightbox data-alt={photo.alt} data-caption="Original graphic">
    <Image
      src={photo.image}
      alt={photo.alt}
      widths={[800, 1200, 1800, 2400, photo.image.width].filter((w) => w <= photo.image.width)}
      sizes="(min-width: 1200px) 1100px, 94vw"
      quality={92}
    />
  </a>
  <figcaption>Original graphic — click to enlarge</figcaption>
</figure>
<Lightbox />

<style>
  .og {
    margin: var(--space-xl) 0 0;
  }

  .og a {
    display: block;
    border-radius: var(--radius-s);
    overflow: hidden;
    border: 1px solid var(--color-line);
    background: #fff;
    cursor: zoom-in;
  }

  .og img {
    width: 100%;
    transition: transform 0.3s ease;
  }

  .og a:hover img {
    transform: scale(1.01);
  }

  .og figcaption {
    margin-top: 0.5rem;
    text-align: center;
    font-size: var(--step--1);
    color: var(--color-muted);
  }
</style>
