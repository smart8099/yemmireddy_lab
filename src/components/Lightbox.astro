---
/**
 * Shared full-screen image viewer. Any link with a data-lightbox attribute
 * (optional data-alt / data-caption) opens in it. Include <Lightbox /> in any
 * component that renders such links; Astro adds the script once per page.
 */
---

<script>
  // One shared lightbox for every gallery on the page.
  let dialog: HTMLDialogElement | null = null;
  let links: HTMLAnchorElement[] = [];
  let current = 0;

  function ensureDialog() {
    if (dialog) return dialog;
    dialog = document.createElement('dialog');
    dialog.className = 'lightbox';
    dialog.innerHTML = `
      <button type="button" class="lb-close" aria-label="Close">×</button>
      <button type="button" class="lb-prev" aria-label="Previous photo">‹</button>
      <figure><img alt="" /><figcaption></figcaption></figure>
      <button type="button" class="lb-next" aria-label="Next photo">›</button>`;
    document.body.append(dialog);
    dialog.querySelector('.lb-close')!.addEventListener('click', () => dialog!.close());
    dialog.querySelector('.lb-prev')!.addEventListener('click', () => open(current - 1));
    dialog.querySelector('.lb-next')!.addEventListener('click', () => open(current + 1));
    dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog!.close(); });
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') open(current - 1);
      if (e.key === 'ArrowRight') open(current + 1);
    });
    return dialog;
  }

  function open(i: number) {
    const d = ensureDialog();
    current = (i + links.length) % links.length;
    const link = links[current];
    const img = d.querySelector('img')!;
    img.src = link.href;
    img.alt = link.dataset.alt ?? '';
    d.querySelector('figcaption')!.textContent = link.dataset.caption || link.dataset.alt || '';
    if (!d.open) d.showModal();
  }

  links = [...document.querySelectorAll<HTMLAnchorElement>('a[data-lightbox]')];
  links.forEach((a, i) =>
    a.addEventListener('click', (e) => {
      e.preventDefault();
      open(i);
    }),
  );
</script>

<style>
  :global(.lightbox) {
    width: min(96vw, 1200px);
    max-height: 94vh;
    padding: 0;
    border: 0;
    background: transparent;
    overflow: visible;
  }

  :global(.lightbox::backdrop) {
    background: rgb(8 20 19 / 0.88);
  }

  :global(.lightbox figure) {
    margin: 0;
  }

  :global(.lightbox img) {
    max-height: 84vh;
    width: auto;
    margin-inline: auto;
    border-radius: var(--radius-s);
  }

  :global(.lightbox figcaption) {
    color: #e6efed;
    text-align: center;
    font-size: var(--step--1);
    margin-top: 0.6rem;
  }

  :global(.lightbox button) {
    position: absolute;
    z-index: 1;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 999px;
    border: 0;
    background: rgb(255 255 255 / 0.9);
    color: var(--color-primary-strong);
    font-size: 1.6rem;
    line-height: 1;
    cursor: pointer;
  }

  :global(.lightbox .lb-close) { top: 0.5rem; right: 0.5rem; }
  :global(.lightbox .lb-prev) { left: 0.5rem; top: 50%; transform: translateY(-50%); }
  :global(.lightbox .lb-next) { right: 0.5rem; top: 50%; transform: translateY(-50%); }
</style>
